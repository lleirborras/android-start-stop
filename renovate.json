{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests"
  ],
  "packageRules": [
    {
      "description": "Stay on JDK 17; newer majors gain nothing for this build.",
      "matchUpdateTypes": [
        "major"
      ],
      "enabled": false,
      "matchDepNames": [
        "java",
        "java-jdk"
      ]
    }
  ]
}
